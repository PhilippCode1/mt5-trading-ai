#!/bin/sh
# Programm NEUAUFBAU: die volle Testsuite vor jedem Push -- dieselbe Suite wie in der CI.
# Kein Bytecode waehrend des Laufs: das Mutationstor (slow) schreibt Mutanten in den
# Arbeitsbaum und stellt sie zurueck; ein in derselben Sekunde erzeugter .pyc bliebe
# sonst als Mutant liegen (Bewertung 03b). Gilt, bis T6 das Tor in eine Kopie verlegt.
PYTHONDONTWRITEBYTECODE=1
export PYTHONDONTWRITEBYTECODE
echo "pre-push: python -m pytest -q -p no:cacheprovider (PYTHONDONTWRITEBYTECODE=1)"
exec python -m pytest -q -p no:cacheprovider
